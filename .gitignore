cache/
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data, models and reports are generated artifacts and stay untracked --
# EXCEPT the small JSON provenance records, which are the evidence that a
# result was measured against a known dataset and model bundle. Git cannot
# re-include a file whose parent directory is excluded, so these use the
# `dir/*` + negation form rather than `dir/`.
data/*
!data/.gitkeep
models/*
!models/.gitkeep
reports/*
!reports/.gitkeep
!reports/baseline.json
